# 🚨 초안(draft) Dockerfile — lxp-ollama-qwen-fileupload.py(실서비스 후보) 전용
#
# 이 이미지는 빌드/기동은 되지만, ../03-environment-config.md에서 제안한 환경변수
# 리팩터링이 코드에 반영되기 전까지는 포트/모델/경로가 여전히 소스코드 하드코딩 값을
# 따릅니다 (기본 포트 8001, Ollama는 host.docker.internal 또는 localhost:11434를 바라봄 —
# docker-compose 네트워크 안에서는 서비스명으로 바꿔야 합니다. 04-deployment-guide.md 참고).
#
# GPU 관련: 이 컨테이너 자체(FastAPI 래퍼 + 임베딩 모델)는 CPU만으로도 동작 가능합니다.
# 실제 LLM 추론은 별도의 Ollama 컨테이너가 담당하며, GPU가 필요한 쪽은 그 컨테이너입니다.

FROM python:3.12-slim

# uv 설치 (공식 배포 이미지에서 바이너리만 복사)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

WORKDIR /app

# 의존성 레이어를 코드보다 먼저 복사해 캐시를 활용합니다.
# 🚨 주의: pyproject.toml에 vllm/bitsandbytes가 무조건적 의존성으로 포함되어 있어,
#    이 서비스는 vLLM을 쓰지 않음에도 설치 용량이 매우 큽니다.
#    (→ 08-migration-checklist.md의 "의존성 그룹 분리" 항목 참고)
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-install-project

COPY lxp-ollama-qwen-fileupload.py ./

# 런타임 산출물 디렉터리 — docker-compose에서 볼륨으로 마운트할 대상
# /data/state    : ChromaDB + 문서 메타데이터 SQLite + 로그 (인스턴스 로컬 볼륨)
# /data/uploads  : 업로드 원본 파일 (NFS 공유 볼륨) — 09-data-architecture.md 참고
RUN mkdir -p /data/state/chroma_db_fileupload /data/uploads

EXPOSE 8001

CMD ["uv", "run", "python", "lxp-ollama-qwen-fileupload.py"]
